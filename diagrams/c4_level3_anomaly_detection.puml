@startuml C4L3_ML
title C4 Level 3 — anomaly-detection
package "anomaly-detection" {
  [gRPC Score] as score
  [ONNX Runtime session] as onnx
  [Ensemble combiner] as ens
  [Feature Store client] as fs
  [MLflow registry client] as reg
  [Warm-up loader] as warm
  [PSI / KS monitors] as drift
  [Champion-challenger router] as cc
  [Redis online features] as redis
}
score --> cc
cc --> onnx
cc --> ens
score --> fs
fs --> redis
warm --> onnx
drift --> score
reg --> warm
@enduml
