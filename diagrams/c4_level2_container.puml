@startuml C4_Level2
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
title C4 Level 2 — Containers (Aegis)

Person(ext, "External clients", "Networks, merchants, UIs")

System_Boundary(aegis, "Aegis") {
  Container(gw, "API Gateway (Kong)", "TLS 1.3, JWT, rate limit, REST→gRPC")
  Container(ing, "txn-ingestion", "Go")
  Container(enr, "enrichment-profile", "Java")
  Container(ref, "reference-data", "Go")
  Container(rul, "rule-engine", "Java")
  Container(ml, "anomaly-detection", "Python/ONNX")
  Container(gr, "graph-analysis", "Java")
  Container(rs, "risk-scoring", "Go")
  Container(cm, "case-management", "NestJS")
  Container(nt, "notification", "Go")
  Container(au, "audit-compliance", "Java")
  Container(ac, "alert-correlation", "Go")
  Container(im, "integrity-monitor", "Go")
  Container(ui, "Web consoles", "React — cases, rules, analytics")
  ContainerDb(pg, "PostgreSQL", "OLTP per service schema or instance")
  ContainerDb(redis, "Redis", "Features, velocity, rate limits")
  ContainerDb(neo, "Neo4j", "Fraud graph")
  ContainerDb(ts, "TimescaleDB", "Channel integrity series")
  ContainerDb(es, "Elasticsearch", "Logs")
  Container(kafka, "Apache Kafka", "Event backbone")
  Container(obs, "Prom/Grafana/Jaeger/ELK", "Observability")
}

Rel(ext, gw, "HTTPS REST OpenAPI")
Rel(gw, ing, "gRPC Submit")
Rel(ing, kafka, "produce transactions.raw")
Rel(kafka, enr, "consume raw")
Rel(enr, kafka, "produce transactions.enriched")
Rel(rs, rul, "gRPC Evaluate", "sync")
Rel(rs, ml, "gRPC Score", "sync")
Rel(rs, gr, "gRPC AnalyseRelationships", "sync")
Rel(kafka, rs, "enriched trigger")
Rel(rs, kafka, "fraud.decisions / fraud.alerts")
Rel(kafka, cm, "alerts")
Rel(kafka, nt, "notifications.outbound")
Rel(kafka, au, "audit.events")
Rel(kafka, gr, "graph.updates")
Rel(kafka, ac, "alerts for correlation")
Rel(im, ts, "writes")
Rel(ui, gw, "HTTPS")
Rel_Back(obs, ing, "metrics/traces")
@enduml
